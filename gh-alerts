#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = []
# ///
"""Print every open GitHub security alert (Dependabot, code scanning, secret
scanning) for the owners of the repos under a work folder, as markdown.

Owners come from the GitHub origins of repos up to two levels deep (eg:
root/org/repo). An organization is read through its org-wide alert endpoints,
which need an org owner or security manager; a user account has no such
endpoints, so each of its non-archived, non-fork repos is read on its own.
Whatever can't be read (no access, a feature turned off) is listed at the end
rather than failing the run.

Needs an authenticated 'gh'. Secret values are never printed, only their type.
"""

import argparse
import json
import re
import subprocess
import sys
from collections import Counter, defaultdict
from concurrent.futures import ThreadPoolExecutor
from dataclasses import dataclass
from datetime import datetime
from pathlib import Path

JOBS = 8
KINDS = ("dependabot", "code-scanning", "secret-scanning")
# Code scanning alerts from non-security rules carry only an error/warning/note
# severity; those rank below every security severity.
SEVERITY_ORDER = ["critical", "high", "medium", "low", "error", "warning", "note"]
GITHUB_REMOTE = re.compile(r"github\.com[:/]([^/]+)/([^/]+?)(?:\.git)?/?$")


@dataclass
class Alert:
    repo: str
    kind: str
    # None for secret scanning, which GitHub doesn't rate.
    severity: str | None
    title: str
    detail: str
    url: str


def gh_api(path: str) -> tuple[list[dict], str | None]:
    """Every item from a paginated list endpoint, or gh's error line."""
    try:
        result = subprocess.run(["gh", "api", "--paginate", "--jq", ".[]", path],
                                capture_output=True, text=True, check=False)
    except OSError as e:
        return [], str(e)
    if result.returncode != 0:
        # gh may follow the HTTP error with a scope hint that's often a red
        # herring, eg: "needs admin:repo_hook" when the account lacks the role.
        lines = result.stderr.strip().splitlines()
        http = [line for line in lines if "(HTTP " in line]
        return [], (http[0] if http else lines[-1] if lines else "gh failed").removeprefix("gh: ")
    return [json.loads(line) for line in result.stdout.splitlines() if line], None


def gh_json(*args: str) -> dict | list | None:
    result = subprocess.run(["gh", *args], capture_output=True, text=True, check=False)
    return json.loads(result.stdout) if result.returncode == 0 and result.stdout.strip() else None


def find_owners(root: Path) -> set[str]:
    """GitHub owners of the origins of repos up to two levels under root."""
    owners = set()
    candidates = [root, *root.glob("*"), *root.glob("*/*")]
    for d in candidates:
        if d.name.startswith(".") or not (d / ".git").is_dir():
            continue
        url = subprocess.run(["git", "-C", str(d), "remote", "get-url", "origin"],
                             capture_output=True, text=True, check=False).stdout.strip()
        if match := GITHUB_REMOTE.search(url):
            owners.add(match.group(1))
    return owners


def to_alert(kind: str, repo: str, a: dict) -> Alert:
    if kind == "dependabot":
        adv, vuln, dep = a["security_advisory"], a["security_vulnerability"], a["dependency"]
        pkg = dep["package"]
        fix = (vuln.get("first_patched_version") or {}).get("identifier")
        ids = adv.get("cve_id") or adv["ghsa_id"]
        detail = f"`{pkg['name']}` ({pkg['ecosystem']}, {dep.get('manifest_path')}) " \
                 f"{vuln['vulnerable_version_range']} -> {f'fix {fix}' if fix else 'no fix yet'} · {ids}"
        return Alert(repo, kind, adv["severity"], adv["summary"], detail, a["html_url"])
    if kind == "code-scanning":
        rule, inst = a["rule"], a.get("most_recent_instance") or {}
        loc = inst.get("location") or {}
        severity = rule.get("security_severity_level") or rule.get("severity")
        detail = f"{a['tool']['name']} `{rule['id']}` at {loc.get('path')}:{loc.get('start_line')}"
        return Alert(repo, kind, severity, rule.get("description") or rule["id"], detail, a["html_url"])
    # The response carries the secret itself in 'secret'; it's deliberately unused.
    validity = a.get("validity")
    detail = f"`{a['secret_type']}`" + (f", validity: {validity}" if validity else "")
    return Alert(repo, kind, None, a["secret_type_display_name"], detail, a["html_url"])


def fetch_owner(owner: str, is_org: bool) -> tuple[list[Alert], list[tuple[str, str]]]:
    """An owner's open alerts, and (where, why) for every endpoint it couldn't read."""
    if is_org:
        targets = [(f"orgs/{owner}", None)]
    else:
        repos = gh_json("repo", "list", owner, "--source", "--no-archived", "--limit", "1000",
                        "--json", "nameWithOwner") or []
        targets = [(f"repos/{r['nameWithOwner']}", r["nameWithOwner"]) for r in repos]
    jobs = [(base, repo, kind) for base, repo in targets for kind in KINDS]
    with ThreadPoolExecutor(JOBS) as pool:
        results = pool.map(lambda j: gh_api(f"{j[0]}/{j[2]}/alerts?state=open&per_page=100"), jobs)
    alerts, failures = [], []
    for (base, repo, kind), (items, err) in zip(jobs, results):
        if err:
            failures.append((f"{repo or owner} {kind}", err))
        for item in items:
            alerts.append(to_alert(kind, repo or item["repository"]["full_name"], item))
    return alerts, failures


def rank(severity: str | None) -> int:
    return SEVERITY_ORDER.index(severity) if severity in SEVERITY_ORDER else len(SEVERITY_ORDER)


def render(alerts: list[Alert], failures: list[tuple[str, str]], skipped: list[str], header: str) -> str:
    lines = [f"# Security alerts", "", header, ""]
    counts = Counter(a.severity or a.kind for a in alerts)
    summary = ", ".join(f"{counts[s]} {s}" for s in sorted(counts, key=rank))
    lines += [f"{len(alerts)} open" + (f": {summary}" if summary else ""), ""]
    by_repo: dict[str, list[Alert]] = defaultdict(list)
    for a in alerts:
        by_repo[a.repo].append(a)
    # Repos with the worst alert first, then by count.
    for repo, items in sorted(by_repo.items(), key=lambda kv: (min(rank(a.severity) for a in kv[1]),
                                                                -len(kv[1]), kv[0])):
        lines += [f"## {repo} ({len(items)})", ""]
        for a in sorted(items, key=lambda a: (rank(a.severity), a.kind, a.title)):
            label = f"**{a.severity}** " if a.severity else ""
            lines += [f"- {label}{a.kind}: {a.title}", f"  {a.detail}", f"  {a.url}"]
        lines.append("")
    if failures or skipped:
        lines += ["## Not read", ""]
        lines += [f"- {owner}: {why}" for owner, why in [(s, "not a GitHub organization or user") for s in skipped]]
        # Collapse identical errors, eg: code scanning not set up on many repos.
        grouped: dict[str, list[str]] = defaultdict(list)
        for where, why in failures:
            grouped[why].append(where)
        for why, wheres in sorted(grouped.items()):
            lines.append(f"- {why}: {', '.join(sorted(wheres))}")
        lines.append("")
    return "\n".join(lines)


def main() -> int:
    parser = argparse.ArgumentParser(
        prog="gh-alerts", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("root", nargs="?", default=str(Path.home() / "work"),
                        help="folder whose repos' owners to read (default: $HOME/work)")
    args = parser.parse_args()

    root = Path(args.root)
    if not root.is_dir():
        print(f"gh-alerts: error: not a folder: {root}", file=sys.stderr)
        return 1
    me = gh_json("api", "user")
    if not me:
        print("gh-alerts: error: 'gh api user' failed; is gh installed and logged in?", file=sys.stderr)
        return 1

    alerts, failures, skipped = [], [], []
    for owner in sorted(find_owners(root), key=str.lower):
        info = gh_json("api", f"users/{owner}")
        if not info:
            skipped.append(owner)
            continue
        owner_alerts, owner_failures = fetch_owner(info["login"], info["type"] == "Organization")
        alerts += owner_alerts
        failures += owner_failures

    rate = (gh_json("api", "rate_limit") or {}).get("resources", {}).get("core", {})
    when = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
    header = f"As {me['login']} at {when}"
    if rate:
        resets = datetime.fromtimestamp(rate["reset"]).strftime("%H:%M")
        header += f"; API calls left: {rate['remaining']}/{rate['limit']} (resets {resets})"
    print(render(alerts, failures, skipped, header))
    return 0


if __name__ == "__main__":
    sys.exit(main())
